
@baseUrl = http://localhost:3000

### 1. Verificar se a API está funcionando
GET {{baseUrl}}/

### 2. Cadastrar funcionário Marcos (público)
POST {{baseUrl}}/funcionario
Content-Type: application/json

{
    "nome": "Marcos",
    "email": "marcos@gmail.com",
    "senha": "123"
}

### 3. Fazer login com Marcos
# @name loginReq
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "marcos@gmail.com",
    "senha": "123"
}



### 3. Cadastrar motorista 1
POST {{baseUrl}}/motorista
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Lucas",
    "cnh": "12345678901",
    "cpf": "12345678909",
    "telefone": "47999123456"
}

### 4. Cadastrar motorista 2
POST {{baseUrl}}/motorista
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Gabriel",
    "cnh": "23456789012",
    "cpf": "98765432100",
    "telefone": "47999098765"
}

### 5. Cadastrar motorista 3
POST {{baseUrl}}/motorista
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Murilo",
    "cnh": "34567890123",
    "cpf": "12309845674",
    "telefone": "47999097643"
}

### 6. Testar CPF com tamanho incorreto (erro 400)
POST {{baseUrl}}/motorista
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Teste CPF",
    "cnh": "45678901234",
    "cpf": "12345",
    "telefone": "48900000000"
}

### 7. Listar todos os motoristas
GET {{baseUrl}}/motoristas
Authorization: {{loginReq.response.body.token}}

### 8. Buscar motorista pelo nome
GET {{baseUrl}}/motorista/buscar/Lucas
Authorization: {{loginReq.response.body.token}}

### 9. Atualizar motorista de código 1
PUT {{baseUrl}}/motorista/1
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Lucas Atualizado",
    "cnh": "12345678901",
    "cpf": "12345678909",
    "telefone": "47999123456"
}

### 10. Excluir motorista 
DELETE {{baseUrl}}/motorista/1
Authorization: {{loginReq.response.body.token}}



### 11. Cadastrar carga vinculada ao motorista 1
POST {{baseUrl}}/carga
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "descricao": "Peças automotivas",
    "peso": "12 kg",
    "volume": "0.5 m3",
    "codigoRastreio": "100001",
    "codMotorista": 2
}

### 12. Cadastrar carga vinculada ao motorista 2
POST {{baseUrl}}/carga
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "descricao": "Equipamentos eletrônicos",
    "peso": "25 kg",
    "volume": "1.2 m3",
    "codigoRastreio": "100002",
    "codMotorista": 2
}

### 13. Cadastrar carga vinculada ao motorista 3
POST {{baseUrl}}/carga
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "descricao": "Materiais de escritório",
    "peso": "20 kg",
    "volume": "0.8 m3",
    "codigoRastreio": "100003",
    "codMotorista": 3
}

### 14. Listar todas as cargas
GET {{baseUrl}}/cargas
Authorization: {{loginReq.response.body.token}}



### 15. Cadastrar entrega 1 - carga 1
POST {{baseUrl}}/entrega
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "cidadeDestino": "Itapema",
    "statusAtual": "ENTREGUE",
    "data": "2026-10-25",
    "hora": "14:00:00",
    "idCarga": 1
}

### 16. Cadastrar entrega 2 - carga 2
POST {{baseUrl}}/entrega
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "cidadeDestino": "São Paulo",
    "statusAtual": "TRANSITO",
    "data": "2026-10-05",
    "hora": "10:30:00",
    "idCarga": 2
}

### 17. Cadastrar entrega 3 - carga 3
POST {{baseUrl}}/entrega
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "cidadeDestino": "Rio de Janeiro",
    "statusAtual": "TRANSITO",
    "data": "2026-10-15",
    "hora": "16:00:00",
    "idCarga": 3
}

### 18. Listar entregas
GET {{baseUrl}}/entregas
Authorization: {{loginReq.response.body.token}}

### 19. Atualizar status da entrega 2
PUT {{baseUrl}}/entrega/2
Authorization: {{loginReq.response.body.token}}
Content-Type: application/json

{
    "statusAtual": "ENTREGUE"
}
